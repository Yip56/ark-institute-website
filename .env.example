# Copy this file to .env and fill in your values
# Never commit .env to git

# Public Cloud Function that serves live fee data from StudioOS Firestore.
# Find the URL in Firebase Console → Functions → getPublicFees, or run:
#   firebase functions:list  (in the studio-os project directory)
VITE_FEES_API_URL=https://asia-southeast1-ark-music-portal.cloudfunctions.net/getPublicFees

# EmailJS — for sending trial booking emails to the studio inbox.
# Sign up at https://www.emailjs.com (free tier: 200 emails/month)
# 1. Add an Email Service (connect your Gmail or Outlook)
# 2. Create an Email Template with these variables:
#    {{from_name}}, {{from_email}}, {{phone}}, {{program}},
#    {{instrument}}, {{experience}}, {{age_group}}, {{message}}
# 3. Copy the IDs from the EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
